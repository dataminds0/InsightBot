# Multi-stage production container build for InsightBot
# Stage 1: Build React/TypeScript frontend
FROM node:20-alpine AS web-builder

WORKDIR /app/apps/web
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci

COPY apps/web/ ./
RUN npm run build

# Stage 2: Python production application
FROM python:3.12-slim AS runtime

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install uv for deterministic dependency resolution
COPY --from=ghcr.io/astral-sh/uv:0.6.5 /uv /bin/uv

# Create non-privileged system user and group (UID/GID 10001)
RUN groupadd -g 10001 insightbot && \
    useradd -u 10001 -g insightbot -s /bin/sh -m insightbot

WORKDIR /app

# Copy dependency configuration and lockfile
COPY pyproject.toml uv.lock README.md ./

# Install python dependencies strictly from lockfile
RUN uv sync --frozen --no-dev

# Copy application source code
COPY src/ ./src/
COPY configs/ ./configs/

# Copy built frontend assets from web-builder for same-origin single-port serving
COPY --from=web-builder /app/apps/web/dist /app/apps/web/dist

# Set up storage and logs directories with correct permissions
RUN mkdir -p /app/data/raw /app/data/exports /app/logs && \
    chown -R insightbot:insightbot /app

# Environment configuration
ENV PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH" \
    INSIGHTBOT_HOST="0.0.0.0" \
    INSIGHTBOT_PORT="8000" \
    INSIGHTBOT_ENV="production" \
    INSIGHTBOT_STATIC_DIR="/app/apps/web/dist" \
    HF_HUB_OFFLINE="1"

# Switch to non-root user
USER insightbot

# Expose HTTP port
EXPOSE 8000

# Container healthcheck using standard loopback health endpoint
HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://127.0.0.1:8000/api/health || exit 1

# Default command: launch Uvicorn with FastAPI
CMD ["uvicorn", "insightbot.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
