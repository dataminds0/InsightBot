# ==============================================================================
# InsightBot Environment Variables (Template)
# Copy to .env and adjust values as needed.
# ==============================================================================

INSIGHTBOT_ENV=development
INSIGHTBOT_HOST=127.0.0.1
INSIGHTBOT_PORT=8000

# MongoDB Configuration
INSIGHTBOT_MONGO_URI=mongodb://127.0.0.1:27017
INSIGHTBOT_MONGO_DB=insightbot
INSIGHTBOT_MONGO_TIMEOUT_MS=5000

# Authentication & Security
# Generate using: uv run insightbot config init --local
INSIGHTBOT_SECRET_KEY=

# Storage Paths
INSIGHTBOT_RAW_STORAGE_PATH=data/raw
INSIGHTBOT_EXPORT_STORAGE_PATH=data/exports
INSIGHTBOT_SOURCES_CONFIG_PATH=configs/sources.yaml

# Localization & Timezone
INSIGHTBOT_TIMEZONE=UTC

# Search & LLM Engine Toggles
INSIGHTBOT_SEARCH_BACKEND=basic
INSIGHTBOT_ENABLE_LLM=false

# Prefect & HuggingFace
PREFECT_API_URL=http://127.0.0.1:4200/api
HF_HUB_OFFLINE=1

# React Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000
