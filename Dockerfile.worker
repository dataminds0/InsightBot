# Production container build for InsightBot background worker
FROM python:3.12-slim AS runtime

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install uv for deterministic dependency resolution
COPY --from=ghcr.io/astral-sh/uv:0.6.5 /uv /bin/uv

# Create non-privileged system user and group (UID/GID 10001)
RUN groupadd -g 10001 insightbot && \
    useradd -u 10001 -g insightbot -s /bin/sh -m insightbot

WORKDIR /app

# Copy dependency configuration and lockfile
COPY pyproject.toml uv.lock README.md ./

# Install python dependencies strictly from lockfile
RUN uv sync --frozen --no-dev

# Copy application source code
COPY src/ ./src/
COPY configs/ ./configs/

# Set up storage and logs directories
RUN mkdir -p /app/data/raw /app/data/exports /app/logs && \
    chown -R insightbot:insightbot /app

# Environment configuration
ENV PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH" \
    INSIGHTBOT_ENV="production" \
    HF_HUB_OFFLINE="1"

# Switch to non-root user
USER insightbot

# Default command: launch background flow worker
CMD ["python", "-m", "insightbot.flows.worker"]
